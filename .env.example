# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_trace
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Tracing Configuration
TRACE_RETENTION_DAYS=90
TRACE_BATCH_SIZE=100
TRACE_FLUSH_INTERVAL_SECONDS=5.0
TRACE_CAPTURE_PROMPTS=true

# Server
SERVICE_NAME=ai-trace
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API auth and tenancy
API_AUTH_ENABLED=false
API_KEY_HEADER=X-API-Key
API_TENANT_HEADER=X-Org-Id
API_REQUIRE_TENANT_HEADER=false
# Format: token:subject:role1|role2:org1|org2
API_KEYS=replace-me:platform-admin:viewer|operator|admin:*
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_REQUESTS_PER_WINDOW=240
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PER_PATH=false

# Runtime operations scheduler
OBSERVABILITY_SCHEDULER_ENABLED=false
OBSERVABILITY_SCHEDULER_ORG_IDS=acme
OBSERVABILITY_SCHEDULER_INTERVAL_SECONDS=60
OBSERVABILITY_SCHEDULER_RUN_DETECTORS=true
OBSERVABILITY_SCHEDULER_RUN_POLICIES=true
OBSERVABILITY_SCHEDULER_EXECUTE_POLICY_ACTIONS=true
OBSERVABILITY_SCHEDULER_ENABLE_NOTIFICATIONS=true

# Detector defaults
OBSERVABILITY_DETECTOR_CURRENT_WINDOW_MINUTES=15
OBSERVABILITY_DETECTOR_BASELINE_WINDOW_HOURS=24
OBSERVABILITY_DETECTOR_API_SPIKE_MULTIPLIER=10
OBSERVABILITY_DETECTOR_COST_SPIKE_MULTIPLIER=5
OBSERVABILITY_DETECTOR_UNUSUAL_RESOURCE_MIN_CALLS=3
OBSERVABILITY_DETECTOR_MEMORY_DIVERGENCE_THRESHOLD=0.3

# Policy safety controls
OBSERVABILITY_SHUTDOWN_REQUIRES_APPROVAL=true
OBSERVABILITY_SHUTDOWN_APPROVAL_MAX_AGE_MINUTES=60

# Notifications
OBSERVABILITY_NOTIFICATION_WEBHOOKS=
OBSERVABILITY_NOTIFICATION_SLACK_WEBHOOKS=
OBSERVABILITY_NOTIFICATION_PAGERDUTY_ROUTING_KEYS=
OBSERVABILITY_NOTIFICATION_TIMEOUT_SECONDS=5
OBSERVABILITY_NOTIFICATION_MAX_ATTEMPTS=3
OBSERVABILITY_NOTIFICATION_RETRY_BACKOFF_SECONDS=0.5
