# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/ai_trace
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# External requests remain blocked until the owning product explicitly authorizes them.
PROVIDER_EXECUTION_ENABLED=false

# Tracing Configuration
TRACE_RETENTION_DAYS=90
TRACE_BATCH_SIZE=100
TRACE_FLUSH_INTERVAL_SECONDS=5.0
# Opt in only after the owning product defines redaction and retention.
TRACE_CAPTURE_PROMPTS=false

# Server
SERVICE_NAME=ai-trace
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Container startup guards
# The local Compose file opts its isolated database in explicitly.
MIGRATE_ON_START=false
PREFLIGHT_ON_START=false
PREFLIGHT_STRICT=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API auth and tenancy
API_AUTH_ENABLED=true
API_KEY_HEADER=X-API-Key
API_TENANT_HEADER=X-Org-Id
API_REQUIRE_TENANT_HEADER=true
# Format: token:subject:role1|role2:org1|org2
# Local-only fixture. Replace before shared or non-development use.
API_KEYS=replace-me:local-operator:viewer|operator|admin:acme
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_WINDOW=240
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PER_PATH=false
API_RATE_LIMIT_MAX_KEYS=10000
# Plain-HTTP localhost only. Production preflight requires true.
BROWSER_SESSION_COOKIE_SECURE=false
BROWSER_SESSION_TTL_MINUTES=480
OPERATOR_CONSOLE_DIST_DIR=web/dist

# Runtime operations scheduler
RUNTIME_GOVERNANCE_ENABLED=false
OBSERVABILITY_SCHEDULER_ENABLED=false
OBSERVABILITY_SCHEDULER_ORG_IDS=
OBSERVABILITY_SCHEDULER_INTERVAL_SECONDS=60
OBSERVABILITY_SCHEDULER_LEASE_SECONDS=30
OBSERVABILITY_SCHEDULER_RUN_DETECTORS=true
OBSERVABILITY_SCHEDULER_RUN_POLICIES=false
OBSERVABILITY_SCHEDULER_EXECUTE_POLICY_ACTIONS=false
RUNTIME_CONTROL_LEASE_SECONDS=60
RUNTIME_CONTROL_MAX_DELIVERY_ATTEMPTS=10
# Enable only after the notification safety settings below are configured.
OBSERVABILITY_SCHEDULER_ENABLE_NOTIFICATIONS=false
# ACTIVE rows are shown only when COALESCE(last_activity_at, started_at) is this recent.
OBSERVABILITY_ACTIVE_SESSION_INACTIVITY_MINUTES=30

# Detector defaults
OBSERVABILITY_DETECTOR_CURRENT_WINDOW_MINUTES=15
OBSERVABILITY_DETECTOR_BASELINE_WINDOW_HOURS=24
OBSERVABILITY_DETECTOR_API_SPIKE_MULTIPLIER=10
OBSERVABILITY_DETECTOR_COST_SPIKE_MULTIPLIER=5
OBSERVABILITY_DETECTOR_UNUSUAL_RESOURCE_MIN_CALLS=3
OBSERVABILITY_DETECTOR_MEMORY_DIVERGENCE_THRESHOLD=0.3
OBSERVABILITY_DETECTOR_ANOMALY_DEDUPE_WINDOW_MINUTES=30
OBSERVABILITY_DETECTOR_ANOMALY_REOPEN_ACKNOWLEDGED=true

# Policy safety controls
OBSERVABILITY_SHUTDOWN_REQUIRES_APPROVAL=true
OBSERVABILITY_SHUTDOWN_APPROVAL_MAX_AGE_MINUTES=60

# Notifications
OBSERVABILITY_NOTIFICATION_WEBHOOKS=
OBSERVABILITY_NOTIFICATION_SLACK_WEBHOOKS=
OBSERVABILITY_NOTIFICATION_PAGERDUTY_ROUTING_KEYS=
# Exact comma-delimited HTTPS hosts. Include hooks.slack.com when Slack is configured.
OBSERVABILITY_NOTIFICATION_ALLOWED_HOSTS=
# Generic webhook URLs whose receiver honors Idempotency-Key.
OBSERVABILITY_NOTIFICATION_IDEMPOTENT_WEBHOOKS=
# Secret value of at least 32 bytes; keep stable while queued deliveries exist.
OBSERVABILITY_NOTIFICATION_FINGERPRINT_KEY=
OBSERVABILITY_NOTIFICATION_MIN_SEVERITY=warning
OBSERVABILITY_NOTIFICATION_ONLY_ON_ACTIONABLE=true
OBSERVABILITY_NOTIFICATION_TIMEOUT_SECONDS=5
OBSERVABILITY_NOTIFICATION_MAX_ATTEMPTS=3
OBSERVABILITY_NOTIFICATION_RETRY_BACKOFF_SECONDS=0.5
OBSERVABILITY_NOTIFICATION_OUTBOX_BATCH_SIZE=25
# Must be at least 5 seconds longer than OBSERVABILITY_NOTIFICATION_TIMEOUT_SECONDS.
OBSERVABILITY_NOTIFICATION_CLAIM_SECONDS=30
OBSERVABILITY_NOTIFICATION_RETENTION_DAYS=30
